<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P04_revisao_prisma" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P04_revisao_prisma">
    <bpmn:participant id="Part_P04_revisao_prisma" name="P04 · Revisão sistemática (PRISMA 2020)" processRef="Proc_P04_revisao_prisma" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P04_revisao_prisma" name="P04 · Revisão sistemática (PRISMA 2020)" isExecutable="false">
    <bpmn:documentation>Objetivo: Executar o protocolo da PBS de forma rastreável e manter o relatório atualizado a cada incorporação. | Gatilho: Nova exportação de base, PDF manual (CAFe) ou nova execução do fluxo | Dono: Mestrando (avaliador único)</bpmn:documentation>
    <bpmn:laneSet id="LS_P04_revisao_prisma">
      <bpmn:lane id="L0_P04_revisao_prisma" name="Avaliador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P04_revisao_prisma" name="rsl_prisma.py">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P04_revisao_prisma" name="Relatórios">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Exportações das bases">
      <bpmn:documentation>Artefato: Metodologia de Pesquisa/exportacoes_capes/registro_buscas.csv</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="01 Identificação e inventário">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/01_inventario_fontes.csv</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="03 Deduplicação">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/03_duplicatas.csv</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t3" name="04 Critérios objetivos CO1–CO4">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/04_criterios_objetivos.csv</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="05 Triagem título/resumo">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/05_triagem_titulo_resumo.csv</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Texto completo recuperado?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u0" name="Baixar via CAFe (manual)">
      <bpmn:documentation>Artefato: revisao_sistematica/textos_para_baixar_CAFe.html</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t5" name="06–07 Elegibilidade no texto">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/06_07_texto_completo_elegibilidade.csv</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t6" name="08 Snowballing (OpenAlex)">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/08_snowballing.csv</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t7" name="09 Qualidade e extração">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/09_extracao_qualidade.csv</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="u1" name="Validar inclusões e notas Q1–Q4">
      <bpmn:documentation>Artefato: revisao_sistematica/dados/09_validacao_avaliador.csv</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t8" name="Registro de incorporações e protocolo">
      <bpmn:documentation>Artefato: scripts/gerar_protocolo_e_relatorio_rsl.py</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t9" name="Relatório da revisão e PBS">
      <bpmn:documentation>Artefato: revisao_sistematica/relatorio_revisao_sistematica.pdf</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Revisão atualizada">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="F3" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="F4" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="F5" sourceRef="g1" targetRef="u0" name="não" />
    <bpmn:sequenceFlow id="F6" sourceRef="u0" targetRef="t1" name="novo PDF" />
    <bpmn:sequenceFlow id="F7" sourceRef="g1" targetRef="t5" name="sim" />
    <bpmn:sequenceFlow id="F8" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="F9" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="F10" sourceRef="t7" targetRef="u1" />
    <bpmn:sequenceFlow id="F11" sourceRef="u1" targetRef="t8" />
    <bpmn:sequenceFlow id="F12" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="F13" sourceRef="t9" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P04_revisao_prisma">
