<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P05_grafo_neo4j" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P05_grafo_neo4j">
    <bpmn:participant id="Part_P05_grafo_neo4j" name="P05 · Grafo veículo–oficina (Neo4j)" processRef="Proc_P05_grafo_neo4j" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P05_grafo_neo4j" name="P05 · Grafo veículo–oficina (Neo4j)" isExecutable="false">
    <bpmn:documentation>Objetivo: Persistir a rede com identificadores pseudonimizados, verificar a carga e testar as comunidades. | Gatilho: Nova base processada de OS | Dono: Mestrando</bpmn:documentation>
    <bpmn:laneSet id="LS_P05_grafo_neo4j">
      <bpmn:lane id="L0_P05_grafo_neo4j" name="Operador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P05_grafo_neo4j" name="graphdb/load_graph.py">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P05_grafo_neo4j" name="Análise">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Base processada de OS">
      <bpmn:documentation>Artefato: dissertacao_frotas/dados/processados/os_consolidadas_processadas.parquet</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u1" name="Criar segredo local (--init-env)">
      <bpmn:documentation>Artefato: graphdb/.env.example</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="u2" name="Subir Neo4j local (docker compose)">
      <bpmn:documentation>Artefato: graphdb/compose.yaml</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t1" name="Pseudonimizar IDs (HMAC-SHA-256)">
      <bpmn:documentation>Artefato: graphdb/load_graph.py</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Gravar nós, SERVICED_AT e projeção">
      <bpmn:documentation>Artefato: graphdb/load_graph.py</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Contagens conferem?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="x" name="Falha de carga">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t3" name="Testes T1–T3 e análises A1–A5">
      <bpmn:documentation>Artefato: scripts/analise_grafos_frotas.py</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="Artigo 5 e seção 10.x">
      <bpmn:documentation>Artefato: scripts/gerar_artigo_grafos.py</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Resultados do grafo">
      <bpmn:documentation>Artefato: dissertacao_frotas/resultados/logs/relatorio_analise_grafos_neo4j.json</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="u1" />
    <bpmn:sequenceFlow id="F1" sourceRef="u1" targetRef="u2" />
    <bpmn:sequenceFlow id="F2" sourceRef="u2" targetRef="t1" />
    <bpmn:sequenceFlow id="F3" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="F4" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="F5" sourceRef="g1" targetRef="x" name="não" />
    <bpmn:sequenceFlow id="F6" sourceRef="g1" targetRef="t3" name="sim" />
    <bpmn:sequenceFlow id="F7" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="F8" sourceRef="t4" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P05_grafo_neo4j">
