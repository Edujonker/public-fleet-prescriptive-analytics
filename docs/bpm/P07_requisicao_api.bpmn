<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P07_requisicao_api" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P07_requisicao_api">
    <bpmn:participant id="Part_P07_requisicao_api" name="P07 · Atendimento de requisição no sistema de gestão (API)" processRef="Proc_P07_requisicao_api" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P07_requisicao_api" name="P07 · Atendimento de requisição no sistema de gestão (API)" isExecutable="false">
    <bpmn:documentation>Objetivo: Atender uma operação do sistema de frotas com autenticação, controle de acesso por papel e registro. | Gatilho: Requisição HTTP do frontend ou de outro cliente | Dono: Sistema</bpmn:documentation>
    <bpmn:laneSet id="LS_P07_requisicao_api">
      <bpmn:lane id="L0_P07_requisicao_api" name="Usuário / frontend">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P07_requisicao_api" name="Middlewares e segurança">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P07_requisicao_api" name="Rotas e serviços">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Requisição HTTP">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/frontend/js/api.js</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Cabeçalhos, limite de upload, CORS">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/main.py</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Validar token JWT">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/security/auth.py</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Token válido?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="x1" name="401 Não autenticado">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Papel permitido?">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/security/auth.py</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="x2" name="403 Acesso restrito">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t3" name="Rota do módulo (11 routers)">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/routes</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="Serviço de negócio">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/services</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="Persistir e registrar">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/database.py</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Resposta JSON">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="F3" sourceRef="g1" targetRef="x1" name="não" />
    <bpmn:sequenceFlow id="F4" sourceRef="g1" targetRef="g2" name="sim" />
    <bpmn:sequenceFlow id="F5" sourceRef="g2" targetRef="x2" name="não" />
    <bpmn:sequenceFlow id="F6" sourceRef="g2" targetRef="t3" name="sim" />
    <bpmn:sequenceFlow id="F7" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="F8" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="F9" sourceRef="t5" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P07_requisicao_api">
    <bpmndi:BPMNPlane id="PL_P07_requisicao_api" bpmnElement="Col_P07_requisicao_api">
