<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P06_atualizacao_relatorios" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P06_atualizacao_relatorios">
    <bpmn:participant id="Part_P06_atualizacao_relatorios" name="P06 · Atualização dos relatórios sem supervisão" processRef="Proc_P06_atualizacao_relatorios" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P06_atualizacao_relatorios" name="P06 · Atualização dos relatórios sem supervisão" isExecutable="false">
    <bpmn:documentation>Objetivo: Regenerar todos os relatórios com os dados novos, dentro de um prazo, e comparar métricas com o backup. | Gatilho: systemd-run do usuário com prazo (ex.: 10:00) | Dono: Automação</bpmn:documentation>
    <bpmn:laneSet id="LS_P06_atualizacao_relatorios">
      <bpmn:lane id="L0_P06_atualizacao_relatorios" name="Pesquisador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P06_atualizacao_relatorios" name="atualizacao_noturna.sh">
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P06_atualizacao_relatorios" name="Saídas">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Disparo com prazo e backup">
      <bpmn:documentation>Artefato: scripts/atualizacao_noturna.sh</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="u1" name="Copiar resultados para archives/">
      <bpmn:documentation>Artefato: archives/</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g0" name="Pipeline principal em execução?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t0" name="Aguardar término do pipeline">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t1" name="Executar próximo gerador (timeout)">
      <bpmn:documentation>Artefato: scripts/atualizacao_noturna.sh</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Prazo atingido?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g2" name="Restam geradores?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t2" name="Comparar JSONs com o backup">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t3" name="Gravar RESUMO.md">
      <bpmn:documentation>Artefato: logs_atualizacao_noturna</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="u2" name="Revisar e publicar">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Fim">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="u1" />
    <bpmn:sequenceFlow id="F1" sourceRef="u1" targetRef="g0" />
    <bpmn:sequenceFlow id="F2" sourceRef="g0" targetRef="t0" name="sim" />
    <bpmn:sequenceFlow id="F3" sourceRef="g0" targetRef="t1" name="não" />
    <bpmn:sequenceFlow id="F4" sourceRef="t0" targetRef="t1" />
    <bpmn:sequenceFlow id="F5" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="F6" sourceRef="g1" targetRef="t2" name="sim" />
    <bpmn:sequenceFlow id="F7" sourceRef="g1" targetRef="g2" name="não" />
    <bpmn:sequenceFlow id="F8" sourceRef="g2" targetRef="t1" name="sim" />
    <bpmn:sequenceFlow id="F9" sourceRef="g2" targetRef="t2" name="não" />
    <bpmn:sequenceFlow id="F10" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="F11" sourceRef="t3" targetRef="u2" />
    <bpmn:sequenceFlow id="F12" sourceRef="u2" targetRef="e" />
  </bpmn:process>
