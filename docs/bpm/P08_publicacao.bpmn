<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P08_publicacao" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P08_publicacao">
    <bpmn:participant id="Part_P08_publicacao" name="P08 · Publicação no repositório público" processRef="Proc_P08_publicacao" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P08_publicacao" name="P08 · Publicação no repositório público" isExecutable="false">
    <bpmn:documentation>Objetivo: Publicar código e resultados sem dados administrativos, textos de terceiros ou segredos. | Gatilho: Decisão do pesquisador de publicar | Dono: Mestrando</bpmn:documentation>
    <bpmn:laneSet id="LS_P08_publicacao">
      <bpmn:lane id="L0_P08_publicacao" name="Pesquisador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P08_publicacao" name="Verificações">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Mudanças prontas">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Aplicar .gitignore (dados, PDFs, caches)">
      <bpmn:documentation>Artefato: .gitignore</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Arquivos &gt; 50 MB?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t3" name="Buscar segredos no conteúdo">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Algum problema?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u1" name="Remover do índice / corrigir">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="u2" name="Commit e push">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Publicado">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="F3" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="F4" sourceRef="g1" targetRef="u1" name="sim" />
    <bpmn:sequenceFlow id="F5" sourceRef="u1" targetRef="t1" />
    <bpmn:sequenceFlow id="F6" sourceRef="g1" targetRef="u2" name="não" />
    <bpmn:sequenceFlow id="F7" sourceRef="u2" targetRef="e" />
  </bpmn:process>
