<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P01_pipeline_cientifico" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P01_pipeline_cientifico">
    <bpmn:participant id="Part_P01_pipeline_cientifico" name="P01 · Pipeline científico (etapas 01–09)" processRef="Proc_P01_pipeline_cientifico" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P01_pipeline_cientifico" name="P01 · Pipeline científico (etapas 01–09)" isExecutable="false">
    <bpmn:documentation>Objetivo: Transformar as bases da SEA/SC em resultados auditáveis e testar as hipóteses H1–H4. | Gatilho: executar_tudo.sh ou execução manual de cada etapa | Dono: Mestrando</bpmn:documentation>
    <bpmn:laneSet id="LS_P01_pipeline_cientifico">
      <bpmn:lane id="L0_P01_pipeline_cientifico" name="Bases SEA/SC">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P01_pipeline_cientifico" name="Pipeline (dissertacao_frotas/src)">
        <bpmn:flowNodeRef>t01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P01_pipeline_cientifico" name="Resultados">
        <bpmn:flowNodeRef>r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Bases brutas disponíveis">
      <bpmn:documentation>Artefato: dados/Geral_de_OS_23439885_202609110934.csv</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t01" name="01 Auditoria dos dados (SHA-256)">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/01_auditoria_dados.py</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Integridade ok?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="x" name="Interromper e corrigir fonte">
      <bpmn:incoming>F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t02" name="02 Pré-processamento e exclusões">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/02_preprocessamento.py</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t03" name="03 Estatística descritiva">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/03_analise_descritiva.py</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t04" name="04 Modelos preditivos">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/04_modelos_preditivos.py</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t05" name="05 Detecção de anomalias">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/05_deteccao_anomalias.py</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t06" name="06 Grafos e comunidades">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/06_teoria_grafos.py</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t07" name="07 XAI (SHAP × LIME)">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/07_explicabilidade_xai.py</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t08" name="08 Otimização MILP">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/08_otimizacao_milp.py</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t09" name="09 Validação das hipóteses">
      <bpmn:documentation>Artefato: dissertacao_frotas/src/09_validacao_estatistica.py</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="r" name="Certificado e tabela oficial">
      <bpmn:documentation>Artefato: dissertacao_frotas/resultados/logs/certificado_reprodutibilidade_cientifica.json</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Resultados publicados">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="t01" />
    <bpmn:sequenceFlow id="F1" sourceRef="t01" targetRef="g1" />
    <bpmn:sequenceFlow id="F2" sourceRef="g1" targetRef="x" name="não" />
    <bpmn:sequenceFlow id="F3" sourceRef="g1" targetRef="t02" name="sim" />
    <bpmn:sequenceFlow id="F4" sourceRef="t02" targetRef="t03" />
    <bpmn:sequenceFlow id="F5" sourceRef="t03" targetRef="t04" />
    <bpmn:sequenceFlow id="F6" sourceRef="t04" targetRef="t05" />
    <bpmn:sequenceFlow id="F7" sourceRef="t05" targetRef="t06" />
    <bpmn:sequenceFlow id="F8" sourceRef="t06" targetRef="t07" />
    <bpmn:sequenceFlow id="F9" sourceRef="t07" targetRef="t08" />
    <bpmn:sequenceFlow id="F10" sourceRef="t08" targetRef="t09" />
    <bpmn:sequenceFlow id="F11" sourceRef="t09" targetRef="r" />
    <bpmn:sequenceFlow id="F12" sourceRef="r" targetRef="e" />
  </bpmn:process>
