<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P02_orquestracao" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P02_orquestracao">
    <bpmn:participant id="Part_P02_orquestracao" name="P02 · Orquestração integrada (executar_tudo)" processRef="Proc_P02_orquestracao" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P02_orquestracao" name="P02 · Orquestração integrada (executar_tudo)" isExecutable="false">
    <bpmn:documentation>Objetivo: Executar em sequência o pipeline, os relatórios, os testes do sistema e a auditoria de segurança. | Gatilho: ./executar_tudo.sh | Dono: Mestrando</bpmn:documentation>
    <bpmn:laneSet id="LS_P02_orquestracao">
      <bpmn:lane id="L0_P02_orquestracao" name="Orquestrador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ef</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P02_orquestracao" name="Etapas">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="executar_tudo.sh">
      <bpmn:documentation>Artefato: executar_tudo.sh</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="t1" name="Etapas 01–09 (P01)">
      <bpmn:documentation>Artefato: executar_todos_os_scripts.py</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="t2" name="10 Compilar dissertação">
      <bpmn:documentation>Artefato: scripts/compilar_dissertacao_mestrado_completa.py</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t3" name="11 Laudo de auditoria">
      <bpmn:documentation>Artefato: scripts/gerar_relatorio_auditoria_pdf.py</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t4" name="12–13 Abastecimentos">
      <bpmn:documentation>Artefato: scripts/processar_abastecimentos.py</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="14 Frota consolidada e leilão">
      <bpmn:documentation>Artefato: scripts/criar_tabela_veiculos_consolidada.py</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t6" name="15–17 Dicionário, artigos, anomalias">
      <bpmn:documentation>Artefato: scripts/compilar_relatorio_anomalias_detalhado.py</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t7" name="19–20 Testes do sistema">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/testar_sistema.py</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t8" name="21–22 DevSecOps e normas">
      <bpmn:documentation>Artefato: scripts/auditoria_seguranca_devsecops.py</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="Alguma etapa falhou?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ef" name="Resumo com falhas">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e" name="Resumo: todas concluídas">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="F3" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="F4" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="F5" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="F6" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="F7" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="F8" sourceRef="t8" targetRef="g" />
    <bpmn:sequenceFlow id="F9" sourceRef="g" targetRef="ef" name="sim" />
    <bpmn:sequenceFlow id="F10" sourceRef="g" targetRef="e" name="não" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P02_orquestracao">
    <bpmndi:BPMNPlane id="PL_P02_orquestracao" bpmnElement="Col_P02_orquestracao">
      <bpmndi:BPMNShape id="S_Part_P02_orquestracao" bpmnElement="Part_P02_orquestracao" isHorizontal="true">
