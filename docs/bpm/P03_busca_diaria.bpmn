<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P03_busca_diaria" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P03_busca_diaria">
    <bpmn:participant id="Part_P03_busca_diaria" name="P03 · Busca diária de literatura" processRef="Proc_P03_busca_diaria" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P03_busca_diaria" name="P03 · Busca diária de literatura" isExecutable="false">
    <bpmn:documentation>Objetivo: Coletar todos os dias artigos novos de acesso aberto, sem raspagem e com controle semântico. | Gatilho: Timer systemd busca-artigos.timer, 08:00, Persistent=true | Dono: Automação</bpmn:documentation>
    <bpmn:laneSet id="LS_P03_busca_diaria">
      <bpmn:lane id="L0_P03_busca_diaria" name="systemd">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>x</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P03_busca_diaria" name="Busca (scripts/buscar_artigos.py)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P03_busca_diaria" name="APIs externas">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="08:00 diário">
      <bpmn:documentation>Artefato: scripts/instalar_agendamento_diario.sh</bpmn:documentation>
      <bpmn:outgoing>F0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_s">
        <bpmn:timeCycle>R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g0" name="Outra busca em curso? (flock)">
      <bpmn:documentation>Artefato: scripts/atualizacao_diaria_artigos.sh</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="x" name="Sair sem buscar">
      <bpmn:incoming>F1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t1" name="Consultar OpenAlex e Semantic Scholar">
      <bpmn:documentation>Artefato: scripts/buscar_artigos.py</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Unir e deduplicar registros">
      <bpmn:documentation>Artefato: scripts/buscar_artigos.py</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="3 blocos presentes?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t3" name="Marcar como fora do escopo">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g2" name="Versão aberta disponível?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t4" name="Baixar PDF (verifica %PDF)">
      <bpmn:documentation>Artefato: scripts/buscar_artigos.py</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t5" name="Gravar resultados, novos e vistos">
      <bpmn:documentation>Artefato: artigos/vistos.json</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Log diário gravado">
      <bpmn:documentation>Artefato: artigos/atualizacoes/logs</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="g0" />
    <bpmn:sequenceFlow id="F1" sourceRef="g0" targetRef="x" name="sim" />
    <bpmn:sequenceFlow id="F2" sourceRef="g0" targetRef="t1" name="não" />
    <bpmn:sequenceFlow id="F3" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="F4" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="F5" sourceRef="g1" targetRef="t3" name="não" />
    <bpmn:sequenceFlow id="F6" sourceRef="g1" targetRef="g2" name="sim" />
    <bpmn:sequenceFlow id="F7" sourceRef="t3" targetRef="t5" />
    <bpmn:sequenceFlow id="F8" sourceRef="g2" targetRef="t4" name="sim" />
    <bpmn:sequenceFlow id="F9" sourceRef="g2" targetRef="t5" name="não" />
    <bpmn:sequenceFlow id="F10" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="F11" sourceRef="t5" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P03_busca_diaria">
    <bpmndi:BPMNPlane id="PL_P03_busca_diaria" bpmnElement="Col_P03_busca_diaria">
      <bpmndi:BPMNShape id="S_Part_P03_busca_diaria" bpmnElement="Part_P03_busca_diaria" isHorizontal="true">
        <dc:Bounds x="40" y="0" width="1574" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L0_P03_busca_diaria" bpmnElement="L0_P03_busca_diaria" isHorizontal="true">
        <dc:Bounds x="74" y="0" width="1540" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L1_P03_busca_diaria" bpmnElement="L1_P03_busca_diaria" isHorizontal="true">
        <dc:Bounds x="74" y="130" width="1540" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L2_P03_busca_diaria" bpmnElement="L2_P03_busca_diaria" isHorizontal="true">
        <dc:Bounds x="74" y="260" width="1540" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_s" bpmnElement="s">
        <dc:Bounds x="136" y="48" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g0" bpmnElement="g0">
        <dc:Bounds x="281" y="43" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_x" bpmnElement="x">
        <dc:Bounds x="436" y="48" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_t1" bpmnElement="t1">
        <dc:Bounds x="394" y="294" width="118" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_t2" bpmnElement="t2">
        <dc:Bounds x="544" y="164" width="118" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g1" bpmnElement="g1">
        <dc:Bounds x="731" y="173" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_t3" bpmnElement="t3">
        <dc:Bounds x="844" y="164" width="118" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_g2" bpmnElement="g2">
        <dc:Bounds x="1031" y="173" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_t4" bpmnElement="t4">
        <dc:Bounds x="1144" y="294" width="118" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_t5" bpmnElement="t5">
        <dc:Bounds x="1294" y="164" width="118" height="62" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_e" bpmnElement="e">
        <dc:Bounds x="1486" y="48" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_F0" bpmnElement="F0">
        <di:waypoint x="170" y="65" />
        <di:waypoint x="281" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1">
        <di:waypoint x="325" y="65" />
        <di:waypoint x="436" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2">
        <di:waypoint x="325" y="65" />
        <di:waypoint x="360" y="65" />
        <di:waypoint x="360" y="325" />
        <di:waypoint x="394" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3">
        <di:waypoint x="512" y="325" />
        <di:waypoint x="528" y="325" />
        <di:waypoint x="528" y="195" />
        <di:waypoint x="544" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4">
        <di:waypoint x="662" y="195" />
