<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P00_cadeia_valor" targetNamespace="https://udesc.br/ppgcap/frota-bpm" exporter="scripts/gerar_mapeamento_bpm.py" exporterVersion="1">
  <bpmn:collaboration id="Col_P00_cadeia_valor">
    <bpmn:participant id="Part_P00_cadeia_valor" name="P00 · Cadeia de valor do projeto" processRef="Proc_P00_cadeia_valor" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P00_cadeia_valor" name="P00 · Cadeia de valor do projeto" isExecutable="false">
    <bpmn:documentation>Objetivo: Visão de ponta a ponta: dos dados da SEA/SC e da literatura aos produtos acadêmicos e ao sistema. | Gatilho: Início de um ciclo de pesquisa ou atualização dos dados | Dono: Mestrando</bpmn:documentation>
    <bpmn:laneSet id="LS_P00_cadeia_valor">
      <bpmn:lane id="L0_P00_cadeia_valor" name="Pesquisador">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_P00_cadeia_valor" name="Automação (scripts)">
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_P00_cadeia_valor" name="Produtos">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Novo ciclo">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Obter extrações da SEA/SC">
      <bpmn:documentation>Artefato: dados/</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="p1" name="P01 Pipeline científico 01–09">
      <bpmn:documentation>Artefato: executar_todos_os_scripts.py</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="p3" name="P03 Busca diária de literatura">
      <bpmn:documentation>Artefato: scripts/atualizacao_diaria_artigos.sh</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="p4" name="P04 Revisão sistemática PRISMA">
      <bpmn:documentation>Artefato: scripts/rsl_prisma.py</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="p5" name="P05 Grafo Neo4j e análise">
      <bpmn:documentation>Artefato: scripts/analise_grafos_frotas.py</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="p6" name="P06 Atualização dos relatórios">
      <bpmn:documentation>Artefato: scripts/atualizacao_noturna.sh</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="t2" name="Dissertação, artigos, SIC, MEP, PBS">
      <bpmn:documentation>Artefato: overleaf_dissertacao_udesc/main.tex</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="p7" name="P07 Sistema de gestão (API)">
      <bpmn:documentation>Artefato: sistema_gestao_frotas/backend/app/main.py</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="p8" name="P08 Publicação no GitHub">
      <bpmn:documentation>Artefato: .gitignore</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="e" name="Ciclo concluído">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s" targetRef="t1" />
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="p1" />
    <bpmn:sequenceFlow id="F2" sourceRef="p1" targetRef="p3" />
    <bpmn:sequenceFlow id="F3" sourceRef="p3" targetRef="p4" />
    <bpmn:sequenceFlow id="F4" sourceRef="p4" targetRef="p5" />
    <bpmn:sequenceFlow id="F5" sourceRef="p5" targetRef="p6" />
    <bpmn:sequenceFlow id="F6" sourceRef="p6" targetRef="t2" />
    <bpmn:sequenceFlow id="F7" sourceRef="t2" targetRef="p7" />
    <bpmn:sequenceFlow id="F8" sourceRef="p7" targetRef="p8" />
    <bpmn:sequenceFlow id="F9" sourceRef="p8" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_P00_cadeia_valor">
    <bpmndi:BPMNPlane id="PL_P00_cadeia_valor" bpmnElement="Col_P00_cadeia_valor">
      <bpmndi:BPMNShape id="S_Part_P00_cadeia_valor" bpmnElement="Part_P00_cadeia_valor" isHorizontal="true">
        <dc:Bounds x="40" y="0" width="1724" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_L0_P00_cadeia_valor" bpmnElement="L0_P00_cadeia_valor" isHorizontal="true">
        <dc:Bounds x="74" y="0" width="1690" height="130" />
      </bpmndi:BPMNShape>
