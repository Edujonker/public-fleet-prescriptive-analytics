# Environment & Secrets
.env
.env.*
!.env.example

# Large Database files (> 100MB blocked by GitHub)
*.db
*.sqlite
*.sqlite3
dados/backups_dr/
*.db-journal
*.db-wal

# Large Raw Datasets & Binary Microdata (> 100MB blocked by GitHub)
dados/
dissertacao_frotas/dados/
resultados/dados_processados.csv
*.xlsb
*.parquet
*.feather
*.AppImage

# Large Archives & Binaries (> 100MB blocked by GitHub)
archives/
*.tar.gz
*.zip
*.tar
*.iso
ISO/

# Virtual Environments & Python Cache
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# IDE & OS files
.vscode/
.kilo/
.DS_Store
Thumbs.db
.~lock.*
public-fleet-prescriptive-analytics/

# Literatura de terceiros (PDFs/TXT baixados) e caches de API: fora do repositório público
artigos/**/*.pdf
artigos/**/*.parcial
revisao_sistematica/textos_completos/
revisao_sistematica/cache/
Metodologia de Pesquisa/exportacoes_capes/**/*.pdf
SIC/.Rhistory
graphdb/.venv/
!revisao_sistematica/dados/
artigos/**/.lock

# Backups locais grandes (dados e resultados antigos)
backup_arquivos_desatualizados/backups_locais/

# Logs de execução (podem conter dados de teste)
logs_execucao_completa.log
logs_atualizacao_noturna/

# LOA 2026 completa (67 MB; pública no portal da SEF/SC)
leis_e_normativas/estaduais_SC/LOA_2026_SC_Lei_19683_completa.pdf

# Arquivos temporários de editor
*.swp
*.swo

# Pedidos às ferramentas de IA (podem conter dados pessoais; disponíveis aos orientadores sob pedido)
docs/registro_uso_ia/prompts/

# Biblio-now: endereço da sessão (contém token), cofre e acervo local
biblio_now/ENDERECO_BIBLIO_NOW.txt
biblio_now/ABRIR_BIBLIO_NOW.html
biblio_now/cofre.bin
biblio_now/.chave_mestra
biblio_now/repositorio/
biblio_now/.venv/

# Histórico do R e PDFs de artigos duplicados (os PDFs de artigos/ já não são versionados)
.Rhistory
backup_arquivos_desatualizados/pdfs_artigos_duplicados_*/
